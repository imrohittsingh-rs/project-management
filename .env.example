# Server
PORT=8000
NODE_ENV=development
SERVER_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<db_user>:<db_password>@mycluster.wj2nerk.mongodb.net/projmanage

# JWT
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
REFRESH_TOKEN_EXPIRY=10d

# Password reset redirect
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# Mailtrap SMTP
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=replace-with-mailtrap-username
MAILTRAP_SMTP_PASS=replace-with-mailtrap-password
